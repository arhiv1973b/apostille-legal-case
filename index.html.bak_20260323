        :root { --gold: #c5a059; --dark: #0a0a0a; --gray: #1e1e1e; --red: #ff4444; --green: #00ff00; --text: #f0f0f0; }
        body { background-color: var(--dark); color: var(--text); font-family: 'Courier New', Courier, monospace; margin: 0; padding: 0; line-height: 1.6; }
        header { background: linear-gradient(180deg, #000, var(--gray)); padding: 3rem 1rem; border-bottom: 3px solid var(--gold); text-align: center; }
        .container { max-width: 1100px; margin: 0 auto; padding: 2rem; }
        
        .concealment-counter { background: linear-gradient(45deg, #1a1a1a, #000); border: 2px solid var(--gold); padding: 2rem; text-align: center; margin-bottom: 3rem; }
        .days-number { font-size: 5rem; font-weight: bold; color: var(--gold); text-shadow: 0 0 10px var(--gold); margin: 0; }
        .days-label { font-size: 1.2rem; color: var(--text); letter-spacing: 3px; margin-bottom: 1rem; }

        .status-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 3rem; }
        .status-box { border: 1px solid var(--gold); padding: 1rem; text-align: center; background: rgba(197, 160, 89, 0.05); }
        .status-box span { display: block; font-size: 0.7rem; color: #888; text-transform: uppercase; }
        .status-box b, .status-box a { color: var(--gold); font-size: 0.95rem; text-decoration: none; }
        .status-box.alert { border-color: var(--red); }
        .status-box.alert b, .status-box.alert a { color: var(--red); }

        .live-monitor { border: 2px solid var(--red); background: #1a0505; padding: 2rem; margin-bottom: 3rem; position: relative; }
        .live-monitor::before { content: "LIVE"; position: absolute; top: 10px; right: 10px; color: var(--red); font-weight: bold; animation: blink 1s infinite; }
        @keyframes blink { 0% { opacity: 1; } 50% { opacity: 0; } 100% { opacity: 1; } }
        
        .vector-card { background: var(--gray); border-left: 5px solid var(--gold); padding: 1.5rem; margin-bottom: 1.5rem; transition: 0.3s; }
        .vector-card:hover { transform: translateX(10px); background: #2a2a2a; }
        .btn { display: inline-block; border: 1px solid var(--gold); color: var(--gold); padding: 0.5rem 1rem; text-decoration: none; margin-top: 1rem; }
        .btn:hover { background: var(--gold); color: #000; }
    </style>
</head>
