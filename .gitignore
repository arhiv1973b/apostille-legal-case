# ============================================================
# .gitignore — JUS COGENS REPO
# Большие файлы НЕ пушим в GitHub (лимит 100MB)
# Они хранятся ЛОКАЛЬНО как резервные копии
# ============================================================

# Большие архивы — хранить только локально
*.tar.gz
*.tar
*.zip
*.bundle

# Бинарные PDF > 50MB — исключить из git
# (апостили в Downloads/Apostilles/ < 1MB — они НЕ исключены)

# Системные
Thumbs.db
.DS_Store
*.tmp
*.log

# Резервные копии
backups/Actor_Backup_*.tar.gz
